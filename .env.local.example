# Copy this file to .env.local before running `npm run dev` (the non-Docker setup).
# This is unrelated to .env / .env.example, which are for the Docker Compose setup instead —
# see docs/DOCKER.md. Use this file only if you're running Node/Python/Mongo/Ollama yourself.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
AUTH_SECRET=<any-random-secret-string>
NEXTAUTH_URL=http://localhost:3000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
PYTHON_CMD=python
