# Copy this file to .env (same folder as docker-compose.yml) before running
# `docker compose up`. This .env is read by Docker Compose itself — it is
# unrelated to the .env.local file used for the non-Docker npm-run-dev setup.

# Any long random string. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Which Ollama model to grade with. Pick based on the host machine:
#   qwen2.5:3b   - works on CPU-only machines with modest RAM (default, safest choice)
#   qwen2.5:14b  - much better grading quality, but needs a strong GPU to run at a
#                  usable speed (see the commented-out GPU block in docker-compose.yml)
# Changing this and running `docker compose up -d` again re-pulls the new model —
# no image rebuild needed.
OLLAMA_MODEL=qwen2.5:3b

# Only change this if you're exposing the app on something other than localhost:3000.
NEXTAUTH_URL=http://localhost:3000

# The very first admin account is created automatically on first `docker compose up`
# (see the bootstrap-admin service). Admin accounts sign in with email + password
# (not a one-time code) — pick a real password here, at least 8 characters.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
